{
  "name": "french-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/prepare-data.mjs",
    "dev": "npm run data && vite --host 127.0.0.1",
    "build": "npm run data && tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run data && vitest run src/logic.test.ts src/progress.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
